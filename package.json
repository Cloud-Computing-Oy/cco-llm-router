{
  "name": "@cloud-computing-oy/llm-router",
  "version": "0.24.1",
  "license": "Apache-2.0",
  "description": "Provider-neutral LLM fallback chains with local budget estimates.",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cloud-Computing-Oy/cco-llm-router.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cohere": "./src/cohere.ts"
  },
  "bin": {
    "cco-llm-usage": "dist/usage.cjs",
    "claude-router": "dist/claude-router.cjs"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": ">=4 <5",
    "@ai-sdk/google": ">=4 <5",
    "@ai-sdk/openai": ">=4 <5",
    "@ai-sdk/provider": ">=4 <5",
    "ai": ">=7 <8",
    "ai-sdk-ollama": ">=4 <5",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "ai-sdk-ollama": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/google": "^4.0.102",
    "@ai-sdk/openai": "^4.0.99",
    "@ai-sdk/provider": "^4.0.31",
    "@types/node": "^22.19.19",
    "ai": "^7.0.148",
    "ai-sdk-ollama": "^4.5.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "scripts": {
    "build:cli": "esbuild src/bin/usage.ts src/bin/claude-router.ts --bundle --platform=node --format=cjs --outdir=dist --out-extension:.js=.cjs",
    "build:model-data": "node --import tsx scripts/build-model-data-cli.ts",
    "check:models": "node --import tsx scripts/check-provider-models.ts",
    "prepack": "npm run build:cli",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "docs",
    "data"
  ]
}
