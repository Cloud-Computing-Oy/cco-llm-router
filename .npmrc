@cloud-computing-oy:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
; Supply-chain hardening: don't install versions published within this window.
; The unit is DAYS and the key requires npm >= 11.10 (verified 2026-10-10:
; npm 11.9 silently ignores it — `before` stays null; 11.10+ translates it to
; a now-minus-days cutoff). The old `10080` evaluated to 10080 days and
; blocked every range resolution; `7` is the intended seven days. Node 22's
; bundled npm 10 does not know the key. `npm ci` from the committed lockfile
; is unaffected either way.
min-release-age=7
