@cloud-computing-oy:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NPM_TOKEN}
; Supply-chain hardening: don't install versions published within this window.
; The unit is DAYS (npm >= 11) — `10080` was mis-scaled and, as 10080 days,
; blocked every range resolution (verified 2026-10-10); `7` = the intended
; seven days. `npm ci` from the committed lockfile is unaffected either way.
min-release-age=7
