    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/openai": {
      "optional": true
    },
    "ai-sdk-ollama": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/google": "^3.0.72",
    "@ai-sdk/openai": "^3.0.63",
    "@ai-sdk/provider": "^3.0.10",
    "@types/node": "^22.19.19",
    "ai": "^6.0.177",
    "ai-sdk-ollama": "^3.8.4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "scripts": {
